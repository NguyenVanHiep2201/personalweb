{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "alt": {
      "default": "Kỷ niệm",
      "type": "string"
    },
    "caption": {
      "default": "",
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "image"
  ]
}