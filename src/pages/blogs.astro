---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Các bài viết chia sẻ" active="Bài viết"><div class="container"><div class="profile-header"><h1>Góc Tản Mạn</h1><p class="tagline">Những góc nhìn</p></div><div class="grid-layout">{posts.map(post=><article class="card">{post.data.cover&&<img class="post-card-cover" src={post.data.cover} alt={post.data.title} loading="lazy">}<div class="card-tag">{post.data.category}</div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div><div class="admin-note">Bạn có thể đăng nhập <a href="/admin/">/admin</a> để tạo bài viết mới, upload ảnh và xuất bản trực tiếp.</div></div></BaseLayout>
